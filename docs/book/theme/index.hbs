<!DOCTYPE html>
<html lang="{{ language }}" class="no-js">
<head>
    <meta charset="UTF-8">
    <title>{{ title }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {{#if favicon}}
    <link rel="shortcut icon" href="{{ path_to_root }}favicon.png">
    {{/if}}

    <!-- mdBook core styles and scripts -->
    <link rel="stylesheet" href="{{ path_to_root }}book.css">
    {{#each additional_css}}
    <link rel="stylesheet" href="{{ path_to_root }}{{ this }}">
    {{/each}}

    <script type="module" src="{{ path_to_root }}book.js"></script>
    {{#each additional_js}}
    <script type="module" src="{{ path_to_root }}{{ this }}"></script>
    {{/each}}
</head>
<body class="ontrack-theme">
<div id="body-container">
    <nav id="sidebar" class="sidebar ontrack-sidebar">
        <div class="sidebar-header ontrack-sidebar-header">
            <a class="sidebar-logo" href="{{ path_to_root }}index.html">
                <span class="sidebar-logo-glow"></span>
                <span class="sidebar-logo-text">{{ title }}</span>
            </a>
        </div>
        <div class="sidebar-search">
            {{{ search }}}
        </div>
        <div class="sidebar-items">
            {{{ menu }}}
        </div>
    </nav>

    <div class="page-wrapper ontrack-page-wrapper">
        <header id="menu-bar" class="menu-bar ontrack-menu-bar">
            <div class="menu-title ontrack-menu-title">{{ chapter_title }}</div>
            <div class="menu-bar-btns">
                {{{ prev }}}
                {{{ next }}}
            </div>
        </header>

        <main id="content" class="content ontrack-content">
            {{{ content }}}
        </main>

        <footer class="book-footer ontrack-footer">
            {{{ footer }}}
        </footer>
    </div>

    <aside class="page-toc ontrack-page-toc">
        {{{ page_toc }}}
    </aside>
</div>
</body>
</html>
