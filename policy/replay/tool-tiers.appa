# Fathom's read-class tools run at this layer. Its one observe-class
# tool needs the human at this layer too, mirroring SPEC §8 (the
# engine default-denies observe and execute without a config
# allowlist — Matt's ruling 2026-10-10).

mcp/fathom/inspect_binary_layout {
  path: "/usr/bin/true"
}
expect allow

mcp/fathom/analyze_function {
  target: "/usr/bin/true"
  function: "main"
}
expect allow

mcp/fathom/inspect_web_capture {
  path: "/home/phaedrus/targets/capture/session.har"
}
expect allow

mcp/fathom/observe_browser {
  url: "https://example.com"
}
expect authority hitl
